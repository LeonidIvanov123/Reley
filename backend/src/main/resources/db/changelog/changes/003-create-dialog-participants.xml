<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

<changeSet id="003-create-dialog-participants" author="reley">

    <createTable tableName="dialog_participants">

        <column name="dialog_id" type="BIGINT">
            <constraints nullable="false"/>
        </column>

        <column name="user_id" type="BIGINT">
            <constraints nullable="false"/>
        </column>

        <column name="joined_at"
                type="TIMESTAMP WITH TIME ZONE">
            <constraints nullable="false"/>
        </column>

    </createTable>

    <addPrimaryKey
            tableName="dialog_participants"
            columnNames="dialog_id, user_id"
            constraintName="pk_dialog_participants"/>

    <addForeignKeyConstraint
            baseTableName="dialog_participants"
            baseColumnNames="dialog_id"
            referencedTableName="dialogs"
            referencedColumnNames="id"
            constraintName="fk_dialog_participants_dialog"
            onDelete="CASCADE"/>

    <addForeignKeyConstraint
            baseTableName="dialog_participants"
            baseColumnNames="user_id"
            referencedTableName="users"
            referencedColumnNames="id"
            constraintName="fk_dialog_participants_user"
            onDelete="CASCADE"/>

</changeSet>

</databaseChangeLog>