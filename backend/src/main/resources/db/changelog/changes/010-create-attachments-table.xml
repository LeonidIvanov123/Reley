<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="010-create-file-attachment-table" author="reley">

        <createTable tableName="file_attachment">

            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="original_file_name" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>

            <column name="extension" type="VARCHAR(100)"/>

            <column name="content_type" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>

            <column name="size" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="storage_key" type="VARCHAR(500)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>

        </createTable>

    </changeSet>

    <changeSet id="create-message-attachment-table"
               author="reley">

        <createTable tableName="message_attachment">

            <column name="attachment_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="dialog_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="message_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addPrimaryKey
                tableName="message_attachment"
                columnNames="attachment_id, message_id"
                constraintName="pk_message_attachment"/>

        <addForeignKeyConstraint
                baseTableName="message_attachment"
                baseColumnNames="attachment_id"
                referencedTableName="file_attachment"
                referencedColumnNames="id"
                constraintName="fk_message_attachment_attachment"/>

        <addForeignKeyConstraint
                baseTableName="message_attachment"
                baseColumnNames="dialog_id"
                referencedTableName="dialogs"
                referencedColumnNames="id"
                constraintName="fk_message_attachment_dialog"/>

        <addForeignKeyConstraint
                baseTableName="message_attachment"
                baseColumnNames="message_id"
                referencedTableName="messages"
                referencedColumnNames="id"
                constraintName="fk_message_attachment_message"/>

        <createIndex
                tableName="message_attachment"
                indexName="idx_message_attachment_dialog">
            <column name="dialog_id"/>
        </createIndex>

        <createIndex
                tableName="message_attachment"
                indexName="idx_message_attachment_message">
            <column name="message_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>