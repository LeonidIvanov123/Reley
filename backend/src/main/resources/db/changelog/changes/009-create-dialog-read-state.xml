<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-dialog-read-state" author="reley">

        <createTable tableName="dialog_read_state">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints
                        primaryKey="true"
                        nullable="false"/>
            </column>

            <column name="dialog_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="last_read_message_id" type="BIGINT"/>

            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

        </createTable>


        <addForeignKeyConstraint
                baseTableName="dialog_read_state"
                baseColumnNames="dialog_id"
                referencedTableName="dialogs"
                referencedColumnNames="id"
                constraintName="fk_dialog_read_state_dialog"
                onDelete="CASCADE"/>


        <addForeignKeyConstraint
                baseTableName="dialog_read_state"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_dialog_read_state_user"
                onDelete="CASCADE"/>


        <addForeignKeyConstraint
                baseTableName="dialog_read_state"
                baseColumnNames="last_read_message_id"
                referencedTableName="messages"
                referencedColumnNames="id"
                constraintName="fk_dialog_read_state_message"
                onDelete="SET NULL"/>


        <addUniqueConstraint
                tableName="dialog_read_state"
                columnNames="dialog_id, user_id"
                constraintName="uk_dialog_read_state_dialog_user"/>


        <createIndex
                tableName="dialog_read_state"
                indexName="idx_dialog_read_state_user_dialog">

            <column name="user_id"/>
            <column name="dialog_id"/>

        </createIndex>

    </changeSet>

</databaseChangeLog>