<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-create-user-sessions" author="reley">

        <createTable tableName="user_sessions">
            <column name="id" type="UUID">
                <constraints primaryKey="true"
                             primaryKeyName="pk_user_sessions"
                             nullable="false"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <column name="last_used_at" type="TIMESTAMP WITH TIME ZONE"/>

            <column name="absolute_expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <column name="revoked_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="user_sessions"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_user_sessions_user"
                onDelete="CASCADE"/>

        <createIndex tableName="user_sessions"
                     indexName="idx_user_sessions_user">
            <column name="user_id"/>
        </createIndex>

        <createTable tableName="refresh_tokens">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"
                             primaryKeyName="pk_refresh_tokens"
                             nullable="false"/>
            </column>

            <column name="session_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="token_hash" type="VARCHAR(64)">
                <constraints nullable="false"
                             unique="true"
                             uniqueConstraintName="uk_refresh_tokens_hash"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <column name="used_at" type="TIMESTAMP WITH TIME ZONE"/>

            <column name="revoked_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="refresh_tokens"
                baseColumnNames="session_id"
                referencedTableName="user_sessions"
                referencedColumnNames="id"
                constraintName="fk_refresh_tokens_session"
                onDelete="CASCADE"/>

        <createIndex tableName="refresh_tokens"
                     indexName="idx_refresh_tokens_session">
            <column name="session_id"/>
        </createIndex>

    </changeSet>
</databaseChangeLog>
