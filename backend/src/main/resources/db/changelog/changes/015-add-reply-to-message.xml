<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="016-add-reply-to-message" author="reley">

        <addColumn tableName="messages">
            <column name="reply_to_message_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="messages"
                baseColumnNames="reply_to_message_id"
                referencedTableName="messages"
                referencedColumnNames="id"
                constraintName="fk_messages_reply_to_message"/>

        <createIndex
                tableName="messages"
                indexName="idx_messages_reply_to_message_id">
            <column name="reply_to_message_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>